{
  "manifest_version": 3,
  "name": "OTP Autofill Authenticator",
  "version": "1.7.3",
  "description": "Detects login + 2FA forms and autofills TOTP codes. Two-step email flow, QR scan, encrypted vault, otpauth import/export.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "alarms",
    "offscreen",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OTP Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "fill-otp": {
      "suggested_key": { "default": "Ctrl+Shift+9" },
      "description": "Autofill the OTP code on the current page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
